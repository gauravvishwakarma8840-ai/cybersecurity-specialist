# =============================================================================
# CyberSentinel AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development                          # development | staging | production
APP_NAME=CyberSentinel AI
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
DEBUG=true

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT (RS256) ---
# Generate with: openssl genpkey -algorithm RSA -out private.pem -pkcs8 -pass pass:none && openssl rsa -pubout -in private.pem -out public.pem
JWT_PRIVATE_KEY_PATH=./certs/private.pem
JWT_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# --- PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=cybersentinel
POSTGRES_USER=cybersentinel_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://cybersentinel_user:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/cybersentinel

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# --- Google Gemini AI ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-pro

# --- Threat Intelligence (optional) ---
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_KEY_HERE
ALIENVAULT_OTX_API_KEY=YOUR_OTX_KEY_HERE

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CyberSentinel AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
